e:["$","$1","c",{"children":[["$","section",null,{"className":"legal-page","children":["$","div",null,{"className":"container legal-page__inner","children":[["$","h1",null,{"children":"Политика обработки персональных данных"}],["$","h2",null,{"children":"1. Общие положения"}],["$","p",null,{"children":"Настоящая политика определяет порядок обработки персональных данных на сайте forma-mauve-delta.vercel.app и меры по их защите в соответствии с Федеральным законом от 27.07.2006 № 152-ФЗ «О персональных данных»."}],["$","p",null,{"children":"Оператор персональных данных: студия FORMA (вымышленная компания, концепт-проект)."}],["$","p",null,{"children":"Это концепт-проект для портфолио разработчика: студия вымышлена, заявки с сайта никуда не отправляются и не сохраняются. Политика показывает, как документ выглядит на рабочем сайте."}],["$","h2",null,{"children":"2. Какие данные обрабатываются"}],["$","p",null,{"children":"Через форму заявки и калькулятор стоимости оператор может получить:"}],["$","ul",null,{"children":[["$","li",null,{"children":"имя;"}],["$","li",null,{"children":"номер телефона или адрес электронной почты;"}],["$","li",null,{"children":"комментарий к заявке и параметры объекта (площадь, тип ремонта), если вы их указали."}]]}],["$","p",null,{"children":"Сайт не использует сервисы веб-аналитики и рекламные счётчики, не подключает сторонние шрифты и не передаёт данные о посещениях в рекламные системы."}],["$","h2",null,{"children":"3. Цели обработки"}],["$","ul",null,{"children":[["$","li",null,{"children":"ответ на заявку и консультация;"}],["$","li",null,{"children":"расчёт предварительной сметы и согласование выезда на замер;"}],["$","li",null,{"children":"заключение и исполнение договора на ремонт или дизайн-проект."}]]}],["$","p",null,{"children":"Данные не используются для рекламных рассылок. Рассылки возможны только при отдельном согласии."}],["$","h2",null,{"children":"4. Правовые основания"}],["$","p",null,{"children":"Обработка ведётся на основании согласия субъекта персональных данных (п. 1 ч. 1 ст. 6 152-ФЗ), которое даётся отдельной отметкой перед отправкой формы, а также для заключения и исполнения договора, стороной которого является субъект (п. 5 ч. 1 ст. 6 152-ФЗ)."}],["$","h2",null,{"children":"5. Порядок и сроки обработки"}],["$","p",null,{"children":"Оператор собирает, записывает, систематизирует, хранит, уточняет, использует и удаляет персональные данные. Автоматизированное принятие решений не применяется."}],["$","p",null,{"children":"Сбор, запись и хранение персональных данных граждан РФ ведутся с использованием баз данных, находящихся на территории Российской Федерации."}],["$","p",null,{"children":"Данные хранятся до достижения цели обработки, но не дольше 1 года с момента последнего обращения, либо до отзыва согласия. После этого они удаляются в течение 30 дней."}],["$","h2",null,{"children":"6. Передача третьим лицам"}],["$","p",null,{"children":"Оператор не передаёт персональные данные третьим лицам без вашего согласия."}],["$","p",null,{"children":"Персональные данные могут быть предоставлены государственным органам только в случаях, прямо предусмотренных законом."}],["$","h2",null,{"children":"7. Права субъекта персональных данных"}],["$","p",null,{"children":"Вы вправе получить сведения об обработке своих данных, потребовать их уточнения, блокирования или удаления, отозвать согласие, а также обжаловать действия оператора в Роскомнадзоре или в суде."}],["$","p",null,{"children":"Чтобы воспользоваться правами или отозвать согласие, напишите оператору: по контактам, указанным на странице «Контакты». Ответ направляется в течение 10 рабочих дней."}],["$","h2",null,{"children":"8. Защита данных"}],["$","p",null,{"children":"Оператор принимает правовые, организационные и технические меры для защиты персональных данных от неправомерного доступа, изменения, распространения и уничтожения: ограничивает круг лиц с доступом, использует защищённое соединение (HTTPS) и надёжные пароли."}],"$L17","$L18","$L19"]}]}],null,"$L1a"]}]
